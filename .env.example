# Copy to .env and fill in. Never commit .env.
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/dm-tool

# From your Meta app dashboard (App settings -> Basic)
META_APP_SECRET=

# Any random string you choose; paste the same value in Meta's webhook setup
WEBHOOK_VERIFY_TOKEN=

# Any long random string; sent as the x-api-key header to call /api/*
ADMIN_API_KEY=

# Check Meta's docs for the current version
GRAPH_VERSION=v27.0
# graph.facebook.com = Unified Login (new apps). graph.instagram.com = old Instagram Login.
GRAPH_HOST=graph.facebook.com
